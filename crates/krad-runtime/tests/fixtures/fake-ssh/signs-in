#!/bin/sh
[ -n "${KRAD_FAKE_SIGN_IN_MARK:-}" ] || exit 255
[ -f "$KRAD_FAKE_SIGN_IN_MARK" ] && exec "$(dirname "$0")/connects" "$@"
case " $* " in
  *" -O "*) exit 255 ;;
  *BatchMode=yes*)
    echo "me@signs-in.invalid: Permission denied (publickey,password)." >&2
    exit 255
    ;;
esac
: > "$KRAD_FAKE_SIGN_IN_MARK"
exit 0
