#!/bin/sh
recording="$(dirname "$0")"
while IFS= read -r line; do
    id=$(printf '%s\n' "$line" | sed -n 's/^{"jsonrpc":"2.0","id":\([0-9]*\),.*/\1/p')
    [ -n "$id" ] || continue
    method=$(printf '%s\n' "$line" | sed -n 's/.*"method":"\([^"]*\)".*/\1/p')
    case "$method" in
        initialize) printf '{"jsonrpc":"2.0","id":%s,"result":{}}\n' "$id" ;;
        thread/start) printf '{"jsonrpc":"2.0","id":%s,"result":%s}\n' "$id" "$(cat "$recording/codex-thread.json")" ;;
        turn/start)
            printf '{"jsonrpc":"2.0","id":%s,"result":{}}\n' "$id"
            cat "$recording/codex-turn.jsonl"
            ;;
        *) printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32601,"message":"unsupported"}}\n' "$id" ;;
    esac
done
