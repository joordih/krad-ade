{
  "id": "github-dark-default",
  "name": "GitHub Dark Default",
  "appearance": "dark",
  "credit": {
    "author": "GitHub (Primer)",
    "license": "MIT",
    "url": "https://github.com/primer/github-vscode-theme"
  },
  "interface": {
    "background": "#010409",
    "surface": "#0d1117",
    "panel": "#161b22",
    "text": "#e6edf3",
    "muted_text": "#7d8590",
    "accent": "#1f6feb",
    "on_accent": "#ffffff",
    "success": "#3fb950",
    "warning": "#d29922",
    "error": "#ff7b72",
    "info": "#58a6ff"
